[sub_resource type="Resource" id="Resource_gfjfg"]
script = ExtResource("1_er5gl")
object_id = "lapis"
rating = "wrong"
response_line = "\"That looks amazing! Let me just...\"
(she opens her purse and digs in. She takes out coins individually)
(this takes a while. She's still going)
(she's checking her pockets now)
(she finally stops, puts five last coins down and smiles. A small mount of coin on the main counter). 
\"I think that's right\"
\"Thank you\"."
metadata/_custom_type_script = "uid://bydhr2ng52824"

