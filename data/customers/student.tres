[resource]
script = ExtResource("2_qw0f6")
id = "student"
display_name = "Angelica"
description = "A young italian student from the Accademia. Always buys expansive pigments, always empties her coin purse, always adds the prices to check if she can afford what she came for. There's something in her eyes. A spark that hasn't yet faded, despite of everything."
greeting = "\"Buongiorno\".
\"I come here a lot. I guess you'll get tired of me eventually. You mom was always very kind to me. I'm very sorry for her passing\". "
request = "\"I'm looking for blue, the best one\".
\"Price does not matter, of course\".
(she says this, but her mended clothes say otherwise)"
outcome = Array[ExtResource("1_er5gl")]([SubResource("Resource_gfjfg"), SubResource("Resource_w2x4q"), SubResource("Resource_l7fc0")])
default_response = "\"Oh. Yeah. Thanks\".
(she double checks what you gave her, and seems about to say something. She doesn't)"
metadata/_custom_type_script = "uid://cel520ih64l37"
