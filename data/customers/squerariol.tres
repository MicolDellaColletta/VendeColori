[resource]
script = ExtResource("1_64k0j")
id = "squerariol"
display_name = "Bepi Scarpa"
description = "Squerariol at the boatyard of San Trovaso. 
Buys Black, nothing else, never asks the price twice. 
Greets the cat first.
Paid in coins from a tin for eleven years."
greeting = "\"...\"
(to the cat, tipping his hat) \"Bondì.\"
(clearing his throat) \"...\""
request = "\"Black. As much as you have, the cheap kind. No sense in the good stuff, it goes under lacquer anyways.\"
\"New boat. Best one out of the squero this year.\" (a beat) \"She'll be on the Grand Canal for the regata.\"
\"It has to hold against the water. That's all I ask of it.\""
outcome = Array[ExtResource("1_wh26d")]([SubResource("Resource_i3hya"), SubResource("Resource_7aj85")])
default_response = "\"Ti me tol par mona?\""
metadata/_custom_type_script = "uid://cel520ih64l37"
